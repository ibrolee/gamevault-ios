{
  "expo": {
    "name": "GameVault",
    "slug": "gamevault",
    "scheme": "gamevault",
    "version": "0.3.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ibrolee.gamevault",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-file-system",
        {
          "enableFileSharing": true,
          "supportsOpeningDocumentsInPlace": true
        }
      ]
    ],
    "platforms": [
      "ios"
    ]
  }
}
